# ---------------------------------------------------------------------------
# FitLoop 环境变量示例
# 复制为 .env.local 后填写。所有变量都是「可选」的：
# 未配置时，食物联网查询与拍照识别会明确提示「未接入」，并保留手动记录入口，
# 核心训练流程与手动饮食记录始终可用。
# ---------------------------------------------------------------------------

# ---------- 食物联网查询（后端代理，密钥只留在服务端） ----------
# 可选值：none（默认，未接入）| usda
# usda = USDA FoodData Central，免费申请：https://fdc.nal.usda.gov/api-key-signup.html
FOOD_DATA_PROVIDER=none
# 服务端专用，切勿加 NEXT_PUBLIC_ 前缀
USDA_API_KEY=

# ---------- 拍照辅助识别（后端代理） ----------
# 可选值：none（默认，未接入）| openai
VISION_PROVIDER=none
OPENAI_API_KEY=
# 可选，默认 https://api.openai.com/v1
OPENAI_BASE_URL=
# 可选，默认 gpt-4o-mini
VISION_MODEL=

# ---------- 多用户后端（暂未实现，预留） ----------
# 当前版本为「本地优先」：数据全部保存在浏览器 IndexedDB，未上传、未做云备份。
# 若未来接入多用户后端，必须实现身份验证与数据权限隔离，并在此配置：
# DATABASE_URL=
# AUTH_SECRET=
